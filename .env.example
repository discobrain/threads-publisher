# Secrets & environment for threads-poster. Copy to .env and fill in.
# Plain KEY=value, no `export`. (Structure lives in threads_poster.toml.)

# --- required: Threads app (Meta App -> Threads use case) ---
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
# Must exactly match a Redirect Callback URL registered under the app's Threads
# use case, byte-for-byte (trailing slash included). It doesn't need to serve
# anything: the browser just needs to land on <uri>?code=... so you can copy the
# URL. Note: the dashboard won't let you save the redirect until the other
# required fields in the Threads settings are filled in.
THREADS_REDIRECT_URI=https://localhost/

# --- required later: Discourse (source of approved drafts) ---
DISCOURSE_URL=https://discourse.example.com
DISCOURSE_API_KEY=your-api-key
DISCOURSE_API_USERNAME=threads-poster

# --- optional overrides (defaults come from threads_poster.toml) ---
# THREADS_CONFIG=threads_poster.toml
# THREADS_TOKEN_PATH=.threads-token.json
# THREADS_LIMIT=500
# THREADS_POLL_INTERVAL=60
# THREADS_DRY_RUN=1
